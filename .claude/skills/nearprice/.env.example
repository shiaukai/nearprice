# 複製成 .env（同一層）後填入金鑰。.env 已列入 .gitignore，不會進版控。
#
# 為什麼要用 .env 而不是 ~/.zshrc：
#   腳本跑在非互動 shell，zsh 只 source ~/.zshenv 不 source ~/.zshrc。
#   金鑰寫在 .zshrc 的話，你手動跑得起來、Claude 自動跑卻會靜默退到備援 provider。
#
# 也可以改放 ~/.config/nearprice/.env，或直接用環境變數。

# Google Geocoding API —— 一般使用者的主力定位服務
# 啟用步驟：Google Cloud Console → 開啟帳單 → 啟用 Geocoding API → 建 API key
GOOGLE_MAPS_API_KEY=

# 自架的 Locus Geo API —— 沒有這個服務就留空，provider 會自動跳過
LOCUS_API_KEY=
